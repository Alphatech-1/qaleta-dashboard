---
import Layout from "../layouts/DashboardLayout.astro";
import { supabase } from "../lib/supabase";

// ============================================
// CONSULTAS SIMPLES QUE FUNCIONAN (PASO 4)
// ============================================
const { data: ventas } = await supabase.from("ventas").select("*");
const { data: gastos } = await supabase.from("gastos").select("*");
const { data: pagos } = await supabase.from("pagos_creditos").select("*");

// Sumar todo sin filtros complicados
const totalVentas = ventas?.reduce((sum, v) => sum + (Number(v.total) || 0), 0) || 0;
const totalGastos = gastos?.reduce((sum, g) => sum + (Number(g.monto) || 0), 0) || 0;
const totalPagos = pagos?.reduce((sum, p) => sum + (Number(p.monto) || 0), 0) || 0;

const flujoCaja = totalVentas + totalPagos - totalGastos;

// ============================================
// SECCIÓN AGREGADA: CRÉDITOS, PRÉSTAMOS Y DEUDAS
// ============================================

// Créditos pendientes (te deben)
const { data: creditos } = await supabase
  .from("creditos")
  .select("*")
  .neq("estado", "pagado");

// Préstamos otorgados (prestaste)
const { data: prestamos } = await supabase
  .from("prestamos")
  .select("*")
  .neq("estado", "pagado");

// Deudas con proveedores (productos fiados que debes)
const { data: deudasProveedores } = await supabase
  .from("productos_fiados")
  .select("*")
  .eq("pagado", false);

// Totales
const totalCreditosPendientes = creditos?.reduce((acc, c) => acc + (Number(c.saldo) || 0), 0) || 0;
const totalPrestamosPendientes = prestamos?.reduce((acc, p) => acc + (Number(p.saldo_pendiente) || 0), 0) || 0;
const totalDeudasProveedores = deudasProveedores?.reduce((acc, d) => acc + ((Number(d.total) || 0) - (Number(d.pagado) || 0)), 0) || 0;
---

<Layout title="Dashboard">
  <div class="space-y-6 sm:space-y-8">
    <div>
      <h1 class="text-2xl sm:text-3xl font-bold text-gray-800 mb-2">📊 Dashboard financiero</h1>
      <p class="text-sm text-gray-600">Flujo de caja REAL - Solo efectivo disponible</p>
    </div>

    <!-- CAJA REAL - Esta parte FUNCIONA (da S/ 736.13) -->
    <div class="bg-gradient-to-r from-green-600 to-emerald-700 rounded-2xl p-6 text-white shadow-xl">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm opacity-90">💰 EFECTIVO EN CAJA</p>
          <p class="text-3xl sm:text-4xl font-bold mt-1">S/ {flujoCaja.toFixed(2)}</p>
          <p class="text-xs opacity-75 mt-2">Disponible para operar</p>
        </div>
        <div class="text-5xl">💵</div>
      </div>
    </div>

    <!-- Resumen de movimientos -->
    <div>
      <h2 class="text-xl font-bold text-gray-800 mb-4">📊 Resumen de movimientos</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="bg-white rounded-xl p-5 shadow-soft border-l-4 border-green-500">
          <p class="text-gray-500 text-sm">💰 Total Ventas</p>
          <p class="text-2xl font-bold text-green-600">S/ {totalVentas.toFixed(2)}</p>
        </div>
        <div class="bg-white rounded-xl p-5 shadow-soft border-l-4 border-blue-500">
          <p class="text-gray-500 text-sm">💳 Cobros de créditos</p>
          <p class="text-2xl font-bold text-blue-600">S/ {totalPagos.toFixed(2)}</p>
        </div>
        <div class="bg-white rounded-xl p-5 shadow-soft border-l-4 border-red-500">
          <p class="text-gray-500 text-sm">❌ Total Gastos</p>
          <p class="text-2xl font-bold text-red-600">S/ {totalGastos.toFixed(2)}</p>
        </div>
      </div>
    </div>

    <!-- ========================================== -->
    <!-- SECCIÓN: CRÉDITOS, PRÉSTAMOS Y DEUDAS       -->
    <!-- ========================================== -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      
      <!-- 1. Créditos pendientes (te deben) -->
      <div class="bg-yellow-50 rounded-xl p-5 border border-yellow-200">
        <div class="flex items-center justify-between mb-3">
          <h3 class="font-bold text-yellow-800">💰 Créditos pendientes</h3>
          <span class="text-2xl">👥</span>
        </div>
        <p class="text-2xl font-bold text-yellow-700">
          S/ {totalCreditosPendientes.toFixed(2)}
        </p>
        <p class="text-xs text-yellow-600 mt-2">
          ⚠️ Este dinero NO está disponible en caja (te lo deben)
        </p>
        <a href="/creditos" class="inline-block mt-3 text-sm text-yellow-700 hover:underline">
          Ver créditos pendientes →
        </a>
      </div>

      <!-- 2. Préstamos otorgados (prestaste) -->
      <div class="bg-indigo-50 rounded-xl p-5 border border-indigo-200">
        <div class="flex items-center justify-between mb-3">
          <h3 class="font-bold text-indigo-800">🏦 Préstamos otorgados</h3>
          <span class="text-2xl">💰</span>
        </div>
        <p class="text-2xl font-bold text-indigo-700">
          S/ {totalPrestamosPendientes.toFixed(2)}
        </p>
        <p class="text-xs text-indigo-600 mt-2">
          ⚠️ Este dinero YA SALIÓ de caja (lo prestaste)
        </p>
        <a href="/prestamos" class="inline-block mt-3 text-sm text-indigo-700 hover:underline">
          Ver préstamos otorgados →
        </a>
      </div>

      <!-- 3. Deudas con proveedores (debes) -->
      <div class="bg-orange-50 rounded-xl p-5 border border-orange-200">
        <div class="flex items-center justify-between mb-3">
          <h3 class="font-bold text-orange-800">📦 Deudas con proveedores</h3>
          <span class="text-2xl">🏪</span>
        </div>
        <p class="text-2xl font-bold text-orange-700">
          S/ {totalDeudasProveedores.toFixed(2)}
        </p>
        <p class="text-xs text-orange-600 mt-2">
          ⚠️ Productos fiados que aún debés pagar
        </p>
        <a href="/productos-fiados" class="inline-block mt-3 text-sm text-orange-700 hover:underline">
          Ver deudas pendientes →
        </a>
      </div>
    </div>

    <!-- Indicadores rápidos -->
    <div class="bg-gradient-to-r from-gray-800 to-gray-900 rounded-xl p-6 text-white">
      <h3 class="font-bold mb-3">📊 Resumen general</h3>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <div>
          <p class="text-xs opacity-75">Total ventas</p>
          <p class="text-xl font-bold">S/ {totalVentas.toFixed(0)}</p>
        </div>
        <div>
          <p class="text-xs opacity-75">Te deben</p>
          <p class="text-xl font-bold">S/ {totalCreditosPendientes.toFixed(0)}</p>
        </div>
        <div>
          <p class="text-xs opacity-75">Prestaste</p>
          <p class="text-xl font-bold">S/ {totalPrestamosPendientes.toFixed(0)}</p>
        </div>
        <div>
          <p class="text-xs opacity-75">Debes</p>
          <p class="text-xl font-bold">S/ {totalDeudasProveedores.toFixed(0)}</p>
        </div>
      </div>
    </div>
  </div>
</Layout>